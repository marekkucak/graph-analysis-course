# Neo4j Configuration (optional for Python-only mode)
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_password_here
NEO4J_ENABLED=false

# Random seed for reproducibility
RANDOM_SEED=42

# Data paths
DATA_DIR=./data
NOTEBOOKS_DIR=./notebooks
REPORTS_DIR=./reports

# Development
DEBUG=false
LOG_LEVEL=INFO
